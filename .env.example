# Postgres (Neon via Vercel Marketplace)
# Pull with: vercel env pull .env.local
DATABASE_URL=

# /por-que — gating narrativo (no es seguridad real)
# Contraseñas para las dos rutas privadas del microsite /por-que.
# Defínelas en Vercel → Project → Settings → Environment Variables.
INVESTOR_PASSWORD=
OPERATOR_PASSWORD=

# Email de contacto que aparece en los CTAs de /por-que/inversor y /por-que/operador.
# Si no se define, se usa "hola@aisapiens.es" como placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=

